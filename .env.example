# ==============================================================================
# AstroVitals — Environment Configuration Template
# Copy this file to .env and insert your API keys / secrets
# ==============================================================================

# --- Demo Mode ----------------------------------------------------------------
# Set to true for offline simulation with mock data; false for production APIs
DEMO_MODE=true

# --- Tiger Data (PostgreSQL + TimescaleDB + pgvector) -------------------------
TIGER_DATA_PASSWORD=astrovitals_secure_2026
DATABASE_URL=postgresql+asyncpg://astrovitals_user:astrovitals_secure_2026@tigerdata:5432/astrovitals

# --- Google Gemini AI (Flight Surgeon & Diagnostic Engine) --------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --- Auth0 Authentication (3-Role RBAC: astronaut, cmo, flight_surgeon) -------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.astrovitals.health
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_SECRET=your_32_byte_session_secret
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com

# --- Twilio Communications (Space-to-Ground Emergency Alerts) -----------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+10987654321

# --- NASA APIs ----------------------------------------------------------------
NASA_DONKI_API_KEY=DEMO_KEY

# --- Frontend Application -----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
